# Local secrets (DO NOT COMMIT). Copy to .env.local and fill values.

# Mailer (Gmail SMTP example)
MAILER_DSN=smtp://YOUR_GMAIL_ADDRESS:YOUR_GMAIL_APP_PASSWORD@smtp.gmail.com:587
MAILER_FROM=YOUR_GMAIL_ADDRESS
APP_PUBLICITE_NOTIFICATION_EMAIL=YOUR_GMAIL_ADDRESS
APP_NOTIFICATION_EMAIL=YOUR_GMAIL_ADDRESS

# AI (Hugging Face)
HUGGINGFACE_API_KEY=hf_your_token_here
