{% extends 'base.html.twig' %}

{% block title %}Edit Evenement{% endblock %}

{% block body %}
        <div class="card" style="padding:1.25rem">
            <h1 style="margin-top:0">Modifier l'événement</h1>
            <p style="color:var(--muted);margin-top:0.25rem">Mettez à jour les informations de l'événement ci-dessous.</p>

            {{ include('evenement/_form.html.twig', {'button_label': 'Mettre à jour'}) }}

            <div style="margin-top:0.75rem;display:flex;gap:.5rem;align-items:center">
                <a href="{{ path('app_evenement_index') }}" class="btn btn-outline">Retour à la liste</a>
                {{ include('evenement/_delete_form.html.twig') }}
            </div>
        </div>
{% endblock %}
