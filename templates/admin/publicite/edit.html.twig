{% extends 'base.html.twig' %}

{% block title %}Publicité{% endblock %}

{% block body %}
<h1>{{ publicite.id ? 'Modifier' : 'Nouvelle' }} publicité</h1>

<div style="margin:.75rem 0;">
    <a class="btn btn-outline" href="{{ path('app_publicite_index') }}">Retour à la liste</a>
</div>

{{ form_start(form) }}
    {{ form_row(form.image) }}
    {{ form_row(form.description) }}
    {{ form_row(form.lien) }}
    {{ form_row(form.sponsorPartenaire) }}
    <button class="btn">{{ publicite.id ? 'Mettre à jour' : 'Créer' }}</button>
{{ form_end(form) }}
{% endblock %}
