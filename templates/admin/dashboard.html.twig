{# templates/dashboard.html.twig #}
{% set title = 'EcoShare — Dashboard' %}
{% set content %}
<div class="layout">
  <aside class="sidebar">
    <h3>EcoShare</h3>
    <ul style="list-style:none;padding:0;margin-top:1rem">
      <li><a href="/dashboard" style="color:white;text-decoration:none">Vue d'ensemble</a></li>
      <li style="margin-top:.5rem"><a href="/evenement" style="color:white;text-decoration:none">Evenement</a></li>
      <li style="margin-top:.5rem"><a href="/sponsor-partenaire" style="color:white;text-decoration:none">Sponsors &amp; Partenaires</a></li>
      <li style="margin-top:.5rem"><a href="/publicite" style="color:white;text-decoration:none">Publicités</a></li>
      <li style="margin-top:.5rem"><a href="/commentaire" style="color:white;text-decoration:none">Commentaire</a></li>
      <li style="margin-top:.5rem"><a href="/outils" style="color:white;text-decoration:none">Outils partagés</a></li>
    </ul>
  </aside>

  <section class="main">
    <h2>Tableau de bord</h2>
    <p style="color:var(--muted)">Aperçu rapide des activités récentes</p>

    <div class="grid" style="margin-top:1rem">
      <div class="kpi">
        <h4>Tous les événements</h4>
        <p style="font-size:1.5rem;margin:0">{{ totalEvents|default(0) }}</p>
      </div>
      <div class="kpi">
        <h4>Commentaires</h4>
        <p style="font-size:1.5rem;margin:0">{{ totalComments|default(0) }}</p>
      </div>
      <div class="kpi">
        <h4>Objets partagés</h4>
        <p style="font-size:1.5rem;margin:0">76</p>
      </div>
    </div>

    {# Dernières actions removed as requested #}

      <div style="margin-top:1.5rem">
        <div class="card">
          <h3>Événements récents et commentaires</h3>
          {% if eventsWithCounts is defined and eventsWithCounts|length > 0 %}
            <table class="data-table">
              <thead>
                <tr>
                  <th>Titre</th>
                  <th>Date</th>
                  <th>Commentaires</th>
                </tr>
              </thead>
              <tbody>
                {% for row in eventsWithCounts %}
                  {% set e = row.event %}
                  <tr>
                    <td>{{ e.titre }}</td>
                    <td>{{ e.dateEvent ? e.dateEvent|date('Y-m-d H:i') : '&mdash;' }}</td>
                    <td>{{ row.comments }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          {% else %}
            <p style="color:var(--muted)">Aucun événement récent.</p>
          {% endif %}
        </div>
      </div>

  </section>
</div>
{% endset %}

{% include 'base.html.twig' with {'title': title, 'content': content} %}
