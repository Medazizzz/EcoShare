{# Admin layout using Gentelella assets under /public/admin #}
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>{% block title %}EcoShare — Admin{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="{{ asset('admin/vendors/bootstrap/dist/css/bootstrap.min.css') }}" rel="stylesheet">
    <link href="{{ asset('admin/vendors/font-awesome/css/font-awesome.min.css') }}" rel="stylesheet">
    <link href="{{ asset('admin/vendors/nprogress/nprogress.css') }}" rel="stylesheet">
    <link href="{{ asset('admin/build/css/custom.min.css') }}" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
  
    <style>
      .nav_title {
        background: #145a32;
      }
      .left_col {
        background: #0b3d28;
      }
      .top_nav {
        background: linear-gradient(135deg, #145a32, #27ae60);
      }
      .nav.side-menu > li > a {
        color: #ecf0f1;
      }
      .nav.side-menu > li > a:hover {
        background: #117a45;
      }
      .nav.side-menu > li.active > a {
        background: #117a45;
      }
    </style>

</head>
  <body class="nav-md">
    <div class="container body">
      <div class="main_container">
        <div class="col-md-3 left_col menu_fixed">
          <div class="left_col scroll-view">
            <div class="navbar nav_title" style="border: 0;">
              <a href="{{ path('home') }}" class="site_title"><i class="fa fa-leaf"></i> <span>EcoShare</span></a>
            </div>
            <div class="clearfix"></div>
            <br />
            <div id="sidebar-menu" class="main_menu_side hidden-print main_menu">
              <div class="menu_section">
                <h3>EcoShare</h3>
                <ul class="nav side-menu">
                  <li>
                    <a href="{{ path('admin_dashboard') }}"><i class="fa fa-tachometer"></i> Dashboard</a>
                  </li>
                  <li>
                    <a><i class="fa fa-users"></i> Users <span class="fa fa-chevron-down"></span></a>
                    <ul class="nav child_menu">
                      <li><a href="#">All Users</a></li>
                    </ul>
                  </li>
                  <li>
                    <a><i class="fa fa-archive"></i> Objects <span class="fa fa-chevron-down"></span></a>
                    <ul class="nav child_menu">
                      <li><a href="#">All Objects</a></li>
                      <li><a href="#">Reservations</a></li>
                    </ul>
                  </li>
                  <li>
                    <a><i class="fa fa-comments"></i> Reviews &amp; Reports <span class="fa fa-chevron-down"></span></a>
                    <ul class="nav child_menu">
                      <li><a href="#">Reviews</a></li>
                      <li><a href="#">Complaints</a></li>
                    </ul>
                  </li>
                  <li>
                    <a href="#"><i class="fa fa-calendar"></i> Events</a>
                  </li>
                  <li>
                    <a><i class="fa fa-bullhorn"></i> Sponsors &amp; Ads <span class="fa fa-chevron-down"></span></a>
                    <ul class="nav child_menu">
                      <li><a href="{{ path('app_sponsor_partenaire_index') }}"><i class="fa fa-handshake-o"></i> Sponsors &amp; partenaires</a></li>
                      <li><a href="{{ path('app_publicite_index') }}">Publicités</a></li>
                    </ul>
                  </li>
                  <li>
                    <a href="#"><i class="fa fa-cog"></i> Settings</a>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
        <div class="top_nav">
          <div class="nav_menu">
            <div class="nav toggle">
              <a id="menu_toggle"><i class="fa fa-bars"></i></a>
            </div>
            <nav class="nav navbar-nav">
              <ul class=" navbar-right">
                <li class="nav-item">
                  <span class="nav-link">Admin</span>
                </li>
              </ul>
            </nav>
          </div>
        </div>
        <div class="right_col" role="main">
          {% block admin_content %}{% endblock %}
        </div>
        <footer>
          <div class="pull-right">
            EcoShare Admin — basé sur Gentelella (light)
          </div>
          <div class="clearfix"></div>
        </footer>
      </div>
    </div>

    <script src="{{ asset('admin/vendors/jquery/dist/jquery.min.js') }}"></script>
    <script src="{{ asset('admin/vendors/bootstrap/dist/js/bootstrap.bundle.min.js') }}"></script>
    <script src="{{ asset('admin/vendors/fastclick/lib/fastclick.js') }}"></script>
    <script src="{{ asset('admin/vendors/nprogress/nprogress.js') }}"></script>
    <script src="{{ asset('admin/build/js/custom.min.js') }}"></script>
    {% block javascripts %}{% endblock %}
  </body>
</html>
