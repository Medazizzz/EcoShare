{% extends 'admin/layout.html.twig' %}

{% block title %}Sponsors & Partenaires{% endblock %}

{% block admin_content %}
<div class="page-title">
    <div class="title_left">
        <h3>Sponsors &amp; partenaires</h3>
    </div>
    <div class="title_right">
        <div class="pull-right">
            <a class="btn btn-default" href="{{ path('admin_dashboard') }}">
                <i class="fa fa-arrow-left"></i> Dashboard
            </a>
            <a class="btn btn-success" href="{{ path('app_sponsor_partenaire_new') }}">
                <i class="fa fa-plus"></i> Ajouter
            </a>
        </div>
    </div>
</div>
<div class="clearfix"></div>

<div class="row">
    <div class="col-md-12">
        <div class="x_panel">
            <div class="x_title">
                <h2>Liste des sponsors &amp; partenaires</h2>
                <ul class="nav navbar-right panel_toolbox">
                    <li>
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </li>
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">
                <table class="table table-striped table-hover">
                    <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Type</th>
                        <th>Logo</th>
                        <th>Lien</th>
                        <th class="text-right" style="width:220px;">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for sponsor in sponsor_partenaires %}
                        <tr>
                            <td class="align-middle">{{ sponsor.nom }}</td>
                            <td class="align-middle">
                                {% if sponsor.type == 'sponsor' %}
                                    <span class="badge bg-success">Sponsor</span>
                                {% elseif sponsor.type == 'partenaire' %}
                                    <span class="badge bg-info">Partenaire</span>
                                {% else %}
                                    <span class="badge bg-secondary">{{ sponsor.type }}</span>
                                {% endif %}
                            </td>
                            <td class="align-middle">
                                {% if sponsor.logo %}
                                    <img src="{{ sponsor.logo }}" alt="{{ sponsor.nom }}"
                                         style="max-height:40px; max-width:140px; object-fit:contain;">
                                {% else %}
                                    <span class="text-muted small">Aucun logo</span>
                                {% endif %}
                            </td>
                            <td class="align-middle">
                                {% if sponsor.lien %}
                                    <a href="{{ sponsor.lien }}" target="_blank">Voir</a>
                                {% else %}
                                    <span class="text-muted small">Aucun lien</span>
                                {% endif %}
                            </td>
                            <td class="align-middle text-right">
                                <div class="btn-group" role="group">
                                    <a class="btn btn-primary btn-sm"
                                       href="{{ path('app_sponsor_partenaire_show', {'id': sponsor.id}) }}">
                                        <i class="fa fa-eye"></i> Consulter
                                    </a>
                                    <a class="btn btn-warning btn-sm"
                                       href="{{ path('app_sponsor_partenaire_edit', {'id': sponsor.id}) }}">
                                        <i class="fa fa-pencil"></i> Modifier
                                    </a>
                                    <form method="post"
                                          action="{{ path('app_sponsor_partenaire_delete', {'id': sponsor.id}) }}"
                                          style="display:inline"
                                          onsubmit="return confirm('Supprimer ce sponsor/partenaire ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ sponsor.id) }}">
                                        <button class="btn btn-danger btn-sm">
                                            <i class="fa fa-trash"></i> Supprimer
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted">
                                Aucun sponsor ou partenaire pour le moment.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
