{% extends 'user/base_user.html.twig' %}

{% block title %}Connexion - EcoShare{% endblock %}

{% block body %}
<section class="page-section" id="login">
  <div class="container">
    <h2 class="page-section-heading text-center text-uppercase text-secondary mb-0">Connexion</h2>
    <div class="divider-custom">
      <div class="divider-custom-line"></div>
      <div class="divider-custom-icon"><i class="fas fa-star"></i></div>
      <div class="divider-custom-line"></div>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-6">
        {% if error %}
          <div class="alert alert-danger">
            {{ error.messageKey|trans(error.messageData, 'security') }}
          </div>
        {% endif %}

        <form method="post">
          <div class="form-floating mb-3">
            <input type="text" name="_username" class="form-control" id="inputUsername" placeholder="Nom d'utilisateur" value="{{ last_username }}" required autofocus>
            <label for="inputUsername">Nom d'utilisateur</label>
          </div>
          <div class="form-floating mb-3">
            <input type="password" name="_password" class="form-control" id="inputPassword" placeholder="Mot de passe" required>
            <label for="inputPassword">Mot de passe</label>
          </div>

          <button class="btn btn-primary btn-xl w-100" type="submit">Se connecter</button>
        </form>
      </div>
    </div>
  </div>
</section>
{% endblock %}
