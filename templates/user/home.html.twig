{% extends 'user/base_user.html.twig' %}

{% block title %}EcoShare — Plateforme éco-solidaire{% endblock %}

{% block body %}
<nav class="navbar navbar-expand-lg navbar-dark fixed-top" id="mainNav">
    <div class="container">
        <a class="navbar-brand fw-bold me-4" href="#page-top"><i class="fa fa-leaf me-2"></i>EcoShare</a>
        <button class="navbar-toggler text-uppercase font-weight-bold bg-primary text-white rounded"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarResponsive"
                aria-controls="navbarResponsive"
                aria-expanded="false"
                aria-label="Toggle navigation">
            Menu
            <i class="fas fa-bars"></i>
        </button>
        <div class="collapse navbar-collapse" id="navbarResponsive">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item mx-0 mx-lg-1">
                    <a class="nav-link py-3 px-0 px-lg-3 rounded" href="#objects">Objets</a>
                </li>
                <li class="nav-item mx-0 mx-lg-1">
                    <a class="nav-link py-3 px-0 px-lg-3 rounded" href="#add-object">Proposer un objet</a>
                </li>
                <li class="nav-item mx-0 mx-lg-1">
                    <a class="nav-link py-3 px-0 px-lg-3 rounded" href="#reservations">Mes réservations</a>
                </li>
                <li class="nav-item mx-0 mx-lg-1">
                    <a class="nav-link py-3 px-0 px-lg-3 rounded" href="#feedback">Avis &amp; Réclamations</a>
                </li>
                <li class="nav-item mx-0 mx-lg-1">
                    <a class="nav-link py-3 px-0 px-lg-3 rounded" href="{{ path('app_sponsors_page') }}">Sponsors &amp; Partenaires</a>
                </li>
                <li class="nav-item mx-0 mx-lg-1">
                    <a class="nav-link py-3 px-0 px-lg-3 rounded" href="{{ path('app_sponsors_page') }}#campagnes">Campagnes publicitaires</a>
                </li>
                <li class="nav-item mx-0 mx-lg-1">
                    <a class="nav-link py-3 px-0 px-lg-3 rounded" href="#profile">Mon profil</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<header class="masthead text-white text-center" style="background: linear-gradient(135deg,#145a32,#1f7a4d);">
    <div class="container d-flex align-items-center flex-column">
        <h1 class="masthead-heading text-uppercase mb-0">EcoShare</h1>
        <p class="masthead-subheading font-weight-light mb-0">
            Donnez, prêtez et réutilisez des objets près de chez vous
        </p>
    </div>
</header>

<section class="page-section" id="objects">
    <div class="container">
        <h2 class="page-section-heading text-center text-uppercase text-secondary mb-0">
            Objets disponibles
        </h2>
        <p class="text-center mt-3">
            Ici tu afficheras la liste des objets disponibles (cartes, images, ville, état...).
        </p>
    </div>
</section>

<section class="page-section bg-light" id="add-object">
    <div class="container">
        <h2 class="page-section-heading text-center text-uppercase text-secondary mb-0">
            Proposer un objet
        </h2>
        <p class="text-center mt-3">
            Ici tu mettras le formulaire d'ajout d'objet (don ou prêt).
        </p>
    </div>
</section>

<section class="page-section" id="reservations">
    <div class="container">
        <h2 class="page-section-heading text-center text-uppercase text-secondary mb-0">
            Mes réservations
        </h2>
        <p class="text-center mt-3">
            Historique des réservations de l'utilisateur, annulation, suivi des emprunts.
        </p>
    </div>
</section>

<section class="page-section bg-light" id="feedback">
    <div class="container">
        <h2 class="page-section-heading text-center text-uppercase text-secondary mb-0">
            Avis &amp; Réclamations
        </h2>
        <p class="text-center mt-3">
            Zone pour laisser un avis, une note ou signaler un problème sur un objet ou un emprunt.
        </p>
    </div>
</section>

<section class="page-section" id="events">
    <div class="container">
        <h2 class="page-section-heading text-center text-uppercase text-secondary mb-0">
            Événements écologiques
        </h2>
        <p class="text-center mt-3">
            Liste des événements à venir (ateliers, nettoyages, dons, etc.).
        </p>
    </div>
</section>

<section class="page-section bg-light" id="profile">
    <div class="container">
        <h2 class="page-section-heading text-center text-uppercase text-secondary mb-0">
            Mon profil
        </h2>
        <p class="text-center mt-3">
            Informations utilisateur, ville, badge &quot;Éco-utilisateur&quot;, etc.
        </p>
    </div>
</section>

<div class="text-center my-5">
    <a class="btn btn-primary btn-xl" href="/admin">
        Accéder au tableau de bord admin
    </a>
</div>
{% endblock %}
