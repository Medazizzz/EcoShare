{% set title = 'EcoShare — Choisir un espace' %}
{% set content %}
<section class="hero">
  <div class="left">
    <h1>Bienvenue sur EcoShare</h1>
    <p>Choisissez comment vous voulez explorer la plateforme&nbsp;: en tant qu'administrateur ou en tant qu'utilisateur.</p>
    <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:1.5rem">
      <a class="btn" href="{{ path('dashboard') }}">Espace admin</a>
      <a class="btn secondary" href="{{ path('user_home') }}">Espace utilisateur</a>
    </div>
    <div class="features" style="margin-top:2rem">
      <div class="card">
        <h3>Espace admin</h3>
        <p class="muted">Gérez les événements, sponsors, partenaires, publicités et commentaires.</p>
      </div>
      <div class="card">
        <h3>Espace utilisateur</h3>
        <p class="muted">Consultez les événements, initiatives et actions éco-responsables.</p>
      </div>
    </div>
  </div>
  <div class="right">
    <img alt="EcoShare illustration" src="data:image/svg+xml;utf8,&lt;svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 260'&gt;&lt;defs&gt;&lt;linearGradient id='g' x1='0' y1='0' x2='1' y2='1'&gt;&lt;stop offset='0%' stop-color='%2322c55e'/&gt;&lt;stop offset='100%' stop-color='%23059b73'/&gt;&lt;/linearGradient&gt;&lt;clipPath id='r'&gt;&lt;rect rx='24' width='400' height='260'/&gt;&lt;/clipPath&gt;&lt;/defs&gt;&lt;g clip-path='url(%23r)'&gt;&lt;rect width='400' height='260' fill='url(%23g)'/&gt;&lt;circle cx='80' cy='80' r='46' fill='white' fill-opacity='0.1'/&gt;&lt;circle cx='320' cy='60' r='32' fill='white' fill-opacity='0.12'/&gt;&lt;path d='M40 210 C120 190 160 140 240 140 C300 140 330 170 380 180 L380 260 L40 260 Z' fill='white' fill-opacity='0.15'/&gt;&lt;/g&gt;&lt;/svg&gt;" style="max-width:420px;width:100%;border-radius:12px;">
  </div>
</section>
{% endset %}
{% include 'base.html.twig' with {'title': title, 'content': content} %}
